# Datasets — too large to commit; download/place locally
datasets/
data/raw/
data/processed/

# Model checkpoints — large binaries, host on HF Hub
checkpoints/
*.pt
*.pth
*.onnx

# Experiment folders: this branch tracks ONLY exp15.
# All other experiment folders stay ignored so a stray `git add .` can't
# accidentally pull them in. Update this section on each new experiment branch.
experiments/*
!experiments/exp15_efficientnet_b0_onecycle_control/
!experiments/exp15_efficientnet_b0_onecycle_control/**

# Branch-local experiment notes. Canonical completed results belong in
# results/experiment_log.md only after the run is complete.
results/tmp_logs/*
!results/tmp_logs/exp15_tmp_log.md

# Local W&B run cache (per-machine, never committed)
wandb/

# Notebook scratch
.ipynb_checkpoints/

# Env and secrets
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
