# Datasets - too large to commit; download/place locally
datasets/
data/raw/
data/processed/

# Model checkpoints - large binaries, host on HF Hub
checkpoints/
*.pt
*.pth
*.onnx

# Experiment folders: this branch owns exp16 only. Parent experiment folders
# remain in history, but only exp16 is whitelisted for new untracked files.
experiments/*
!experiments/exp16_mobilenetv3large_grouped_split/
!experiments/exp16_mobilenetv3large_grouped_split/**

# Local W&B run cache (per-machine, never committed)
wandb/

# Dataset audit contact sheets contain source-image thumbnails. They are
# reproducible local review artifacts, not repository artifacts.
results/data_integrity/**/contact_sheets/

# Notebook scratch
.ipynb_checkpoints/

# Env and secrets
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
