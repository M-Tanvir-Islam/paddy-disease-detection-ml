# Datasets — too large to commit; download/place locally
datasets/
data/raw/
data/processed/

# Model checkpoints — large binaries, host on HF Hub
checkpoints/
*.pt
*.pth
*.onnx

# Experiment folders: this branch (exp01_mobilenetv3small) tracks ONLY exp01.
# All other experiment folders stay ignored so a stray `git add .` can't
# accidentally pull them in. When you create exp02's branch, update this
# section there to whitelist exp02 instead.
experiments/*
!experiments/exp01_mobilenetv3small_baseline/
!experiments/exp01_mobilenetv3small_baseline/**

# Local W&B run cache (per-machine, never committed)
wandb/

# Notebook scratch
.ipynb_checkpoints/

# Env and secrets
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
