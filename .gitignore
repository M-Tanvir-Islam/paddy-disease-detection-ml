# Datasets — too large to commit; download/place locally
datasets/
data/raw/
data/processed/

# Model checkpoints — large binaries, host on HF Hub
checkpoints/
*.pt
*.pth
*.onnx

# Experiment folders: this branch (exp02_mobilenetv3large) tracks ONLY exp02.
# All other experiment folders stay ignored so a stray `git add .` can't
# accidentally pull them in. Update this section on each new experiment branch.
experiments/*
!experiments/exp02_mobilenetv3large_baseline/
!experiments/exp02_mobilenetv3large_baseline/**

# Local W&B run cache (per-machine, never committed)
wandb/

# Notebook scratch
.ipynb_checkpoints/

# Env and secrets
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
