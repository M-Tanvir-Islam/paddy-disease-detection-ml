# Datasets — too large to commit; download/place locally
datasets/
data/raw/
data/processed/

# Model checkpoints — large binaries, host on HF Hub
checkpoints/
*.pt
*.pth
*.onnx

# Experiment folders: this branch tracks exp03 baseline context, exp11, exp12, and exp13.
# All other experiment folders stay ignored so a stray `git add .` can't
# accidentally pull them in. Update this section on each new experiment branch.
experiments/*
!experiments/exp03_efficientnetb0_baseline/
!experiments/exp03_efficientnetb0_baseline/**
!experiments/exp11_efficientnet_b0_augmentation/
!experiments/exp11_efficientnet_b0_augmentation/**
!experiments/exp12_efficientnet_b0_weighted/
!experiments/exp12_efficientnet_b0_weighted/**
!experiments/exp13_efficientnet_b0_onecycle/
!experiments/exp13_efficientnet_b0_onecycle/**

# Local W&B run cache (per-machine, never committed)
wandb/

